# Server-only key. Never use NEXT_PUBLIC_ for credentials.
GEMINI_API_KEY=
# Override with a generateContent + structured-output capable model available to your key.
GEMINI_MODEL=gemini-3.1-flash-lite

# Set to the externally reachable HTTPS origin behind a TLS reverse proxy.
# Leave blank for local development. No trailing path.
PROFILY_PUBLIC_BASE_URL=
# Optional absolute path; persist its parent directory (profiles + sibling stores).
PROFILY_DATA_DIR=

# Optional server-only token for public GitHub API quota. Never use NEXT_PUBLIC_.
# Use only the minimum public-repository read permissions required.
GITHUB_TOKEN=

# Durable Redis required on Vercel; Upstash integration supplies this pair.
# Never expose these variables through NEXT_PUBLIC_.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternatively use UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
# Different namespaces isolate preview and production records and quotas.
PROFILY_STORAGE_PREFIX=profily:local
