{
  "name": "profily-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src README.md *.json *.mjs",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:live": "node scripts/live-workflow.mjs",
    "test:interview": "node scripts/live-interview.mjs",
    "test:public": "node scripts/live-public.mjs",
    "test:routes": "node scripts/smoke-routes.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "unpdf": "2.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
